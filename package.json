{
  "name": "sidemaster",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Editor desktop de guias de sideboard Pauper",
  "author": "SideMaster",
  "desktopName": "io.sidemaster.app",
  "main": "electron/main.cjs",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/generate-icons.mjs",
    "test": "node --test tests/*.test.mjs",
    "dist:linux": "electron-builder --linux AppImage --x64",
    "dist:win": "electron-builder --win --x64",
    "dist:appimage-portable": "electron-builder --linux AppImage --win portable --x64",
    "dist:dir": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "io.sidemaster.app",
    "productName": "SideMaster",
    "linux": {
      "target": [{ "target": "AppImage", "arch": ["x64"] }],
      "icon": "electron/assets/sidemaster-icon.png",
      "category": "Office",
      "syncDesktopName": true,
      "artifactName": "SideMaster-${version}-${arch}.${ext}"
    },
    "asar": true,
    "directories": { "output": "release" },
    "files": [
      "electron/**",
      "src/**",
      "index.html",
      "package.json",
      "!src/app.js",
      "!src/**/test*"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "electron/assets/sidemaster-icon.ico",
      "artifactName": "SideMaster-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "SideMaster-${version}-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "SideMaster-${version}-Portable.${ext}"
    }
  }
}
